# Public URL of the deployed site. Used for canonical links, Open Graph and the sitemap.
# On Vercel set this in Project Settings -> Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Web3Forms access key for the contact form (free: https://web3forms.com, enter mddanisha288@gmail.com, the key is emailed).
# Public by design: it can only send to the inbox it was created for. Without it, the form opens the visitor's mail app instead.
NEXT_PUBLIC_WEB3FORMS_KEY=
